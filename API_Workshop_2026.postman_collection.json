					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://api.scuacm.com/v1/token?key={{key}}",
							"protocol": "https",
							"host": [
								"api",
								"scuacm",
								"com"
							],
							"path": [
								"v1",
								"token"
