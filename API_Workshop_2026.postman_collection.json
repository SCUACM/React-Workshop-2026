									"key": "key",
									"value": "{{key}}"
								}
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Save response to data variable",
									"let data = pm.response.json();",
									"",
									"// Set the token value to the collection variable",
									"pm.collectionVariables.set(\"token\", data.token);"
								]
							}
						}
					]
				},
				{
					"name": "Get Data",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
